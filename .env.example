# fnOS: replace CHAT_BIND_IP with its ZeroTier IP to let your clients connect.
CHAT_BIND_IP=127.0.0.1
CHAT_HOSTS=127.0.0.1,localhost
# chatgpt: one-time owner authorization. api_key: separate API Platform billing.
AUTH_MODE=api_key
OPENAI_MODEL=
# Optional: match the user that owns the data directory; default container UID/GID is 10001.
CHAT_UID=10001
CHAT_GID=10001
